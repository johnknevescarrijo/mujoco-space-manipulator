<mujoco model="space_manipulator">
  <compiler angle="radian" coordinate="local"/>

  <option gravity="0 0 0" timestep="0.002" integrator="RK4"/>

  <visual>
    <global offwidth="1280" offheight="720"/>
    <headlight diffuse="0.28 0.28 0.32" ambient="0.16 0.16 0.20" specular="0.35 0.35 0.35"/>
    <map znear="0.05" zfar="100.0"/>
  </visual>

  <default>
    <geom contype="1" conaffinity="1" condim="3" friction="0.6 0.05 0.01"/>
    <joint damping="0.1" armature="0.02"/>
    <motor ctrllimited="true"/>
  </default>

  <asset>
    <!-- Deep-space skybox with subtle starfield -->
    <texture type="skybox" builtin="flat" rgb1="0.01 0.015 0.03" rgb2="0.0 0.0 0.01"
             mark="random" markrgb="0.85 0.9 1.0" random="0.004" width="1024" height="1024"/>

    <!-- Subtle orbital reference grid -->
    <texture name="ref_grid_tex" type="2d" builtin="checker"
             rgb1="0.04 0.06 0.10" rgb2="0.055 0.08 0.13"
             mark="edge" markrgb="0.14 0.22 0.35" width="512" height="512"/>
    <material name="ref_grid_mat" texture="ref_grid_tex" texrepeat="12 12"
              texuniform="true" reflectance="0.0"/>

    <!-- CAD 3D meshes exported in millimeters (mm) -> scale="0.001 0.001 0.001" to meters -->
    <mesh name="sat_bus_frame" file="meshes/sat_bus_frame.stl" scale="0.001 0.001 0.001"/>
    <mesh name="sat_mli_foil" file="meshes/sat_mli_foil.stl" scale="0.001 0.001 0.001"/>
    <mesh name="sat_rcs_thrusters" file="meshes/sat_rcs_thrusters.stl" scale="0.001 0.001 0.001"/>
    <mesh name="solar_array_frame" file="meshes/solar_array_frame.stl" scale="0.001 0.001 0.001"/>
    <mesh name="solar_array_cells" file="meshes/solar_array_cells.stl" scale="0.001 0.001 0.001"/>

    <mesh name="arm_link1_housing" file="meshes/arm_link1_housing.stl" scale="0.001 0.001 0.001"/>
    <mesh name="arm_link1_accents" file="meshes/arm_link1_accents.stl" scale="0.001 0.001 0.001"/>
    <mesh name="arm_link2_housing" file="meshes/arm_link2_housing.stl" scale="0.001 0.001 0.001"/>
    <mesh name="arm_link2_accents" file="meshes/arm_link2_accents.stl" scale="0.001 0.001 0.001"/>
    <mesh name="arm_link3_wrist" file="meshes/arm_link3_wrist.stl" scale="0.001 0.001 0.001"/>
    <mesh name="arm_gripper" file="meshes/arm_gripper.stl" scale="0.001 0.001 0.001"/>

    <mesh name="target_sat_body" file="meshes/target_sat_body.stl" scale="0.001 0.001 0.001"/>
    <mesh name="target_grapple_fixture" file="meshes/target_grapple_fixture.stl" scale="0.001 0.001 0.001"/>

    <!-- Rich aerospace PBR-like materials -->
    <material name="gold_mli" rgba="0.88 0.66 0.14 1.0" specular="0.95" shininess="0.85" reflectance="0.35"/>
    <material name="bus_alloy" rgba="0.68 0.71 0.76 1.0" specular="0.75" shininess="0.65" reflectance="0.15"/>
    <material name="aero_white" rgba="0.91 0.92 0.94 1.0" specular="0.45" shininess="0.50" reflectance="0.05"/>
    <material name="carbon_fiber" rgba="0.16 0.17 0.20 1.0" specular="0.40" shininess="0.45" reflectance="0.04"/>
    <material name="solar_cell" rgba="0.05 0.14 0.42 1.0" specular="0.85" shininess="0.90" reflectance="0.25"/>
    <material name="anodized_accent" rgba="0.82 0.44 0.12 1.0" specular="0.85" shininess="0.75" reflectance="0.20"/>
    <material name="rcs_dark" rgba="0.20 0.22 0.26 1.0" specular="0.65" shininess="0.60" reflectance="0.10"/>
    <material name="target_hull" rgba="0.74 0.31 0.18 1.0" specular="0.70" shininess="0.65" reflectance="0.12"/>
  </asset>

  <worldbody>
    <!-- Space illumination (sunlight + faint Earthshine fill) -->
    <light name="sun_light" directional="true" pos="6 -6 10" dir="-0.45 0.45 -0.77"
           diffuse="0.95 0.94 0.90" specular="0.65 0.65 0.65" castshadow="true"/>
    <light name="earthshine" directional="true" pos="-4 4 -6" dir="0.4 -0.4 0.8"
           diffuse="0.18 0.24 0.35" specular="0.12 0.12 0.12" castshadow="false"/>

    <!-- Visual-only reference grid below spacecraft (no collision in microgravity) -->
    <geom name="ref_grid" type="plane" pos="0 0 -1.5" size="12 12 0.1"
          material="ref_grid_mat" contype="0" conaffinity="0" rgba="1 1 1 0.35"/>

    <!-- Servicing satellite base (6-DoF free-floating/free-flying) -->
    <body name="base_sat" pos="0 0 0">
      <freejoint name="base_freejoint"/>
      <inertial pos="0 0 0" mass="45.0" diaginertia="6.0 2.6 6.0"/>

      <!-- Physics collision primitives (hidden in group 3) -->
      <geom name="base_bus_core" type="box" size="0.30 0.30 0.30" group="3" rgba="0 0 0 0"/>
      <geom name="solar_wing_pos_y" type="box" pos="0 0.92 0" size="0.22 0.50 0.012" group="3" rgba="0 0 0 0"/>
      <geom name="solar_wing_neg_y" type="box" pos="0 -0.92 0" size="0.22 0.50 0.012" group="3" rgba="0 0 0 0"/>

      <!-- CAD 3D visual meshes -->
      <geom name="vis_sat_bus_frame" type="mesh" mesh="sat_bus_frame" material="bus_alloy"
            contype="0" conaffinity="0" group="0"/>
      <geom name="vis_sat_mli_foil" type="mesh" mesh="sat_mli_foil" material="gold_mli"
            contype="0" conaffinity="0" group="0"/>
      <geom name="vis_sat_rcs_thrusters" type="mesh" mesh="sat_rcs_thrusters" material="rcs_dark"
            contype="0" conaffinity="0" group="0"/>
      <geom name="vis_solar_array_frame" type="mesh" mesh="solar_array_frame" material="carbon_fiber"
            contype="0" conaffinity="0" group="0"/>
      <geom name="vis_solar_array_cells" type="mesh" mesh="solar_array_cells" material="solar_cell"
            contype="0" conaffinity="0" group="0"/>

      <!-- Base IMU & thruster application site -->
      <site name="base_imu_site" pos="0 0 0" size="0.03" rgba="1.0 0.55 0.0 0.9"/>

      <!-- 3-DoF Serial Robotic Arm mounted on +X face -->
      <!-- Joint ranges bound the arm outside the bus/solar-wing self-collision envelope -->
      <body name="link1" pos="0.33 0 0">
        <inertial pos="0.04 0 0" mass="2.0" diaginertia="0.01 0.01 0.01"/>
        <joint name="joint1" type="hinge" axis="0 0 1" range="-1.0 1.0" damping="0.1" armature="0.02"/>

        <geom name="link1_hub" type="cylinder" pos="0 0 0" size="0.055 0.05" group="3" rgba="0 0 0 0"/>
        <geom name="link1_bracket" type="box" pos="0.045 0 0" size="0.045 0.04 0.04" group="3" rgba="0 0 0 0"/>

        <geom name="vis_arm_link1_housing" type="mesh" mesh="arm_link1_housing" material="aero_white"
              contype="0" conaffinity="0" group="0"/>
        <geom name="vis_arm_link1_accents" type="mesh" mesh="arm_link1_accents" material="anodized_accent"
              contype="0" conaffinity="0" group="0"/>

        <body name="link2" pos="0.09 0 0">
          <inertial pos="0.275 0 0" mass="3.5" diaginertia="0.02 0.10 0.10"/>
          <joint name="joint2" type="hinge" axis="0 1 0" range="-1.52 1.52" damping="0.1" armature="0.02"/>

          <geom name="joint2_housing" type="cylinder" pos="0 0 0" quat="0.707107 0.707107 0 0"
                size="0.05 0.055" group="3" rgba="0 0 0 0"/>
          <geom name="link2_boom" type="capsule" fromto="0 0 0 0.55 0 0" size="0.038" group="3" rgba="0 0 0 0"/>

          <geom name="vis_arm_link2_housing" type="mesh" mesh="arm_link2_housing" material="aero_white"
                contype="0" conaffinity="0" group="0"/>
          <geom name="vis_arm_link2_accents" type="mesh" mesh="arm_link2_accents" material="anodized_accent"
                contype="0" conaffinity="0" group="0"/>

          <body name="link3" pos="0.55 0 0">
            <inertial pos="0.27 0 0" mass="2.5" diaginertia="0.015 0.07 0.07"/>
            <joint name="joint3" type="hinge" axis="0 1 0" range="-1.95 1.95" damping="0.1" armature="0.02"/>

            <geom name="joint3_housing" type="cylinder" pos="0 0 0" quat="0.707107 0.707107 0 0"
                  size="0.044 0.048" group="3" rgba="0 0 0 0"/>
            <geom name="link3_boom" type="capsule" fromto="0 0 0 0.50 0 0" size="0.032" group="3" rgba="0 0 0 0"/>
            <geom name="ee_palm" type="box" pos="0.52 0 0" size="0.022 0.055 0.025" group="3" rgba="0 0 0 0"/>

            <geom name="vis_arm_link3_wrist" type="mesh" mesh="arm_link3_wrist" material="aero_white"
                  contype="0" conaffinity="0" group="0"/>
            <geom name="vis_arm_gripper" type="mesh" mesh="arm_gripper" material="rcs_dark"
                  contype="0" conaffinity="0" group="0"/>

            <site name="ee_site" pos="0.60 0 0" size="0.025" rgba="0.1 1.0 0.45 0.95"/>
          </body>
        </body>
      </body>
    </body>

    <!-- Mocap floating target satellite for dynamic 3D positioning -->
    <body name="target_satellite" mocap="true" pos="1.35 0.25 0.20">
      <geom name="vis_target_sat_body" type="mesh" mesh="target_sat_body" material="target_hull"
            contype="0" conaffinity="0" group="0"/>
      <geom name="vis_target_grapple_fixture" type="mesh" mesh="target_grapple_fixture" material="gold_mli"
            contype="0" conaffinity="0" group="0"/>
      <site name="target_site" pos="0 0 0" size="0.028" rgba="1.0 0.2 0.2 0.95"/>
    </body>
  </worldbody>

  <actuator>
    <!-- 6-DoF base RCS / reaction-wheel actuators (zeroed in free-floating mode) -->
    <motor name="base_fx" site="base_imu_site" gear="1 0 0 0 0 0" ctrlrange="-50 50"/>
    <motor name="base_fy" site="base_imu_site" gear="0 1 0 0 0 0" ctrlrange="-50 50"/>
    <motor name="base_fz" site="base_imu_site" gear="0 0 1 0 0 0" ctrlrange="-50 50"/>
    <motor name="base_tx" site="base_imu_site" gear="0 0 0 1 0 0" ctrlrange="-20 20"/>
    <motor name="base_ty" site="base_imu_site" gear="0 0 0 0 1 0" ctrlrange="-20 20"/>
    <motor name="base_tz" site="base_imu_site" gear="0 0 0 0 0 1" ctrlrange="-20 20"/>

    <!-- 3-DoF arm joint torque actuators -->
    <motor name="act_joint1" joint="joint1" gear="1" ctrlrange="-25 25"/>
    <motor name="act_joint2" joint="joint2" gear="1" ctrlrange="-25 25"/>
    <motor name="act_joint3" joint="joint3" gear="1" ctrlrange="-20 20"/>
  </actuator>

  <sensor>
    <!-- Base state sensors -->
    <framepos name="base_pos" objtype="site" objname="base_imu_site"/>
    <framequat name="base_quat" objtype="site" objname="base_imu_site"/>
    <framelinvel name="base_linvel" objtype="site" objname="base_imu_site"/>
    <frameangvel name="base_angvel" objtype="site" objname="base_imu_site"/>

    <!-- End-effector state sensors -->
    <framepos name="ee_pos" objtype="site" objname="ee_site"/>
    <framequat name="ee_quat" objtype="site" objname="ee_site"/>
    <framelinvel name="ee_linvel" objtype="site" objname="ee_site"/>
    <frameangvel name="ee_angvel" objtype="site" objname="ee_site"/>

    <!-- Arm joint position and velocity sensors -->
    <jointpos name="joint1_pos" joint="joint1"/>
    <jointpos name="joint2_pos" joint="joint2"/>
    <jointpos name="joint3_pos" joint="joint3"/>
    <jointvel name="joint1_vel" joint="joint1"/>
    <jointvel name="joint2_vel" joint="joint2"/>
    <jointvel name="joint3_vel" joint="joint3"/>
  </sensor>
</mujoco>
